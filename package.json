{
  "name": "magic-copy",
  "displayName": "Magic Copy — Inline CSS",
  "version": "0.1.0",
  "description": "Copy any HTML element with all computed CSS styles inlined. Works from the page right-click menu and from a DevTools Elements sidebar.",
  "author": "Nico Epp",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "css-to-tailwindcss": "^1.0.5",
    "js-beautify": "^1.15.4",
    "monaco-editor": "^0.55.1",
    "plasmo": "0.90.5",
    "postcss": "^8.5.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.278",
    "@types/js-beautify": "^1.14.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "manifest": {
    "permissions": [
      "contextMenus",
      "activeTab",
      "scripting",
      "clipboardWrite",
      "debugger"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
