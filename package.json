{
  "name": "magic-copy",
  "displayName": "Magic Copy — Inline CSS",
  "version": "0.1.0",
  "description": "Copy any HTML element with all computed CSS styles inlined. Works from the page right-click menu and from a DevTools Elements sidebar.",
  "author": "Nico Epp",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.278",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "manifest": {
    "permissions": [
      "contextMenus",
      "activeTab",
      "scripting",
      "clipboardWrite"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
